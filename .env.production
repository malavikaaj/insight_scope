# Production Environment Configuration
# Copy this file to .env and update the values

# LLM Provider Configuration
LLM_PROVIDER=gpt4all
GPT4ALL_MODEL=orca-mini-3b-gguf2-q4_0.gguf
GPT4ALL_MODEL_PATH=/app/models/

# Alternative: OpenAI Configuration (uncomment if using OpenAI)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Ollama Configuration (uncomment if using Ollama)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database
VECTOR_DB_PATH=/app/vector_db

# Text Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# MongoDB (if using)
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DB_NAME=insight_scope

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0